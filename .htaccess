# Seguridad básica (Apache / XAMPP)
Options -Indexes

# Tipos MIME para la PWA y la app Android
AddType application/manifest+json .webmanifest
AddType application/json .json

# Bloquear archivos ocultos (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquear archivos de configuración y documentación del proyecto
<FilesMatch "(?i)\.(md|yml|yaml|example|log)$|^Dockerfile$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # config/ y src/ no deben ser accesibles desde el navegador
    RewriteRule ^(config|src)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    # El service worker y el manifest deben revisarse siempre (para que lleguen las actualizaciones)
    <FilesMatch "^(sw\.js|manifest\.webmanifest|assetlinks\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^assetlinks\.json$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "microphone=(self), camera=(), geolocation=()"
</IfModule>
