# Copia este archivo como .env y coloca AL MENOS UNA clave.
# ¡Nunca subas el archivo .env a GitHub!
#
# Si configuras varias, la app usa la primera que funcione y, si una falla
# (caída, sin cuota, clave inválida), pasa sola a la siguiente.

# Recomendado: Google Gemini (gratis, excelente en español)
# Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Respaldo gratis y muy rápido: Groq
# Clave: https://console.groq.com/keys
GROQ_API_KEY=

# Opcional, de pago: Claude (Anthropic) o OpenAI
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Opcional: proveedor preferido (gemini | groq | anthropic | openai)
# AI_PROVIDER=gemini

# Opcional: cambiar el modelo de cada proveedor.
# Puedes poner varios separados por comas: si uno está saturado se usa el siguiente.
# GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-5-mini

# Opcional (XAMPP/Windows): ruta a cacert.pem si cURL falla con errores SSL.
# Descárgalo de https://curl.se/ca/cacert.pem
# CURL_CA_BUNDLE=C:\xampp\php\extras\ssl\cacert.pem
