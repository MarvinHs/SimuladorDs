# Copia este archivo como .env y coloca tu API key de Groq.
# Consíguela gratis en https://console.groq.com/keys
# ¡Nunca subas el archivo .env a GitHub!
GROQ_API_KEY=

# Opcional: modelo de Groq a usar (por defecto openai/gpt-oss-120b)
# GROQ_MODEL=llama-3.3-70b-versatile

# Opcional (XAMPP/Windows): ruta a cacert.pem si cURL falla con errores SSL.
# Descárgalo de https://curl.se/ca/cacert.pem
# CURL_CA_BUNDLE=C:\xampp\php\extras\ssl\cacert.pem
